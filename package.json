{
  "name": "ecommerce-mercadopago-backend",
  "version": "0.1.0",
  "description": "Backend Node.js + Express para el ecommerce con integración MercadoPago (estado en memoria).",
  "type": "module",
  "main": "src/server.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "start:prod": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "mercadopago": "^3.6.1",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/uuid": "^9.0.8",
    "fast-check": "^3.17.0",
    "vitest": "^1.4.0"
  }
}
