# Puerto del servidor HTTP del backend
PORT=3000

# Origen del frontend permitido por CORS (Angular dev server)
FRONTEND_ORIGIN=http://localhost:4200

# Access token de MercadoPago (SECRETO, solo server-side). Usa el de PRUEBA de tu
# aplicación en el panel de MercadoPago. No commitear el valor real.
MP_ACCESS_TOKEN=APP_USR-tu-access-token-de-prueba

# Base URL de la API de MercadoPago
MP_API_BASE_URL=https://api.mercadopago.com

# Secreto del webhook de MercadoPago para validar la firma x-signature (SECRETO).
# Se obtiene al configurar el webhook en el panel. No commitear el valor real.
MP_WEBHOOK_SECRET=

# Base pública del backend usada para construir notification_url del webhook.
# En local puede exponerse con un túnel (p. ej. ngrok) para recibir notificaciones.
BACKEND_PUBLIC_URL=http://localhost:3000

# Integrator ID del Programa de Partners de MercadoPago (identifica la integración; no es secreto)
MP_INTEGRATOR_ID=dev_24c65fb163bf11ea96500242ac130004

# Email de la cuenta de MercadoPago que se incluye en el external_reference para el paso de
# homologación "Identifica la compra" (formato external_reference = "email|Order.id"). Opcional:
# si se deja vacío, el external_reference será solo el Order.id (comportamiento previo).
MP_EXTERNAL_REFERENCE_EMAIL=tu-correo@ejemplo.com

# Nota: el Public Key de MercadoPago NO va aquí. El frontend lo consume desde su propio
# environment (frontend/src/environments), ya que es una credencial pública de cliente.
