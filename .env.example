# Entorno de la aplicacion. Usar `production` en el hosting (Railway) para activar la
# validacion estricta de arranque (credenciales productivas). Cualquier otro valor o
# ausencia => modo no-produccion (flujo local). APP_ENV explicito manda sobre NODE_ENV.
APP_ENV=development

# Puerto del servidor HTTP del backend. En produccion el host (Railway) suele inyectar
# PORT automaticamente; si esta ausente o no es un entero > 0, se usa 3000 por defecto.
PORT=3000

# Origen del frontend permitido por CORS. En local, el dev server de Angular.
# En produccion, el origen publico del frontend (p. ej. https://<app>.vercel.app).
FRONTEND_ORIGIN=http://localhost:4200

# Access token de MercadoPago (SECRETO, solo server-side). En produccion debe ser el token
# PRODUCTIVO de la cuenta principal, con prefijo `APP_USR-`. No commitear el valor real.
MP_ACCESS_TOKEN=APP_USR-tu-access-token

# Base URL de la API de MercadoPago
MP_API_BASE_URL=https://api.mercadopago.com

# Secreto del webhook de MercadoPago para validar la firma x-signature (SECRETO).
# Se obtiene al configurar el webhook en el panel. Requerido en produccion. No commitear.
MP_WEBHOOK_SECRET=tu-webhook-secret

# Base publica del backend usada para construir notification_url del webhook.
# En local puede exponerse con un tunel (p. ej. ngrok). En produccion, la URL publica del
# backend (p. ej. https://<app>.up.railway.app).
BACKEND_PUBLIC_URL=http://localhost:3000

# Integrator ID del Programa de Partners de MercadoPago (identifica la integracion; no es secreto)
MP_INTEGRATOR_ID=dev_24c65fb163bf11ea96500242ac130004

# Email del comprador que se incluye en `payer.email` de la Preference (checklist de
# homologacion). Configurable por entorno. El external_reference usa el Order.id.
MP_PAYER_EMAIL=tu-correo@ejemplo.com

# Nota: el Public Key de MercadoPago NO va aqui. El frontend lo consume desde su propio
# environment (frontend/src/environments), ya que es una credencial publica de cliente.
